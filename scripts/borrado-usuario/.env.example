# Copia este archivo a ".env" (en esta misma carpeta) y rellena los valores.
# El archivo .env NO debe subirse al repositorio (ya está en .gitignore).
# NO pongas claves reales en ESTE archivo (.env.example SÍ se versiona).

# URL del proyecto Supabase
SUPABASE_URL=https://ckdksfvxjimxuqceoeyr.supabase.co

# Clave SECRETA service_role (Supabase -> Project Settings -> API -> service_role).
# Es un JWT largo que empieza por "eyJ...". NO uses la clave anon/public.
SUPABASE_SERVICE_ROLE_KEY=eyJ...pega_aqui_tu_service_role...

# Seguridad: "true" = solo simula (no borra). Cambia a "false" para borrar de verdad.
DRY_RUN=true

